{
  "name": "rilievo-acustico",
  "version": "4.0.0",
  "description": "Rilievo acustico di un ambiente: misura, analisi e progetto del trattamento fonoassorbente",
  "author": "Studio M - Massimiliano Mascioli Trippa",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "build": "node build.js",
    "test": "node test/engine.test.js",
    "start": "node build.js && electron .",
    "dist": "node build.js && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "jspdf": "2.5.1",
    "jszip": "3.10.1"
  },
  "build": {
    "appId": "it.studiom.rilievoacustico",
    "productName": "Rilievo Acustico",
    "files": [
      "desktop/main.js",
      "desktop/app/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Rilievo Acustico usa il microfono per misurare la risposta acustica dell'ambiente."
      },
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage"
      ],
      "maintainer": "Studio M"
    },
    "afterSign": "desktop/adhoc-sign.js"
  }
}
